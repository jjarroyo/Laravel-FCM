{
    "name": "jjarroyo/laravel-fcm",
    "description": "Laravel / Lumen package for Firebase Cloud Messaging",
    "keywords": ["laravel", "lumen", "firebase", "notification", "push", "fcm", "firebase cloud messaging"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nicolas Brosy",
            "email": "nicolas.brosy@gmail.com"
        },
        {
            "name": "Thomas Alrek",
            "email": "thomas@apility.no"
        },
        {
            "name": "Jorge",
            "email": "jorgejaraba18@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0",
        "monolog/monolog": "^2.0|^3.0",
        "google/apiclient": "^2.14",
        "ext-json": "*"
    },
    "require-dev": {
        "mockery/mockery": "^1.4",
        "phpunit/phpunit": "^10.0|^11.0",
        "php-coveralls/php-coveralls": "^2.5",
        "orchestra/testbench": "^8.0|^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelFCM\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaravelFCM\\Tests\\": "tests/",
            "LaravelFCM\\Mocks\\": "tests/mocks/"
        }
    },
    "replace": {
        "brozot/laravel-fcm": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelFCM\\FCMServiceProvider"
            ],
            "aliases": {
                "FCM": "LaravelFCM\\Facades\\FCM",
                "FCMGroup": "LaravelFCM\\Facades\\FCMGroup"
            }
        }
    }
}